  "skills": [
    {
      "alias": "grill-me",
      "skill": "grill-me",
      "level": "L1",
      "description": "通过连续追问收敛需求、计划和设计边界。",
      "inputs": ["用户请求", "现有约束"],
      "outputs": ["澄清结论", "开放问题"]
    },
    {
      "alias": "grill-with-docs",
      "skill": "grill-with-docs",
      "level": "L1",
      "description": "压力测试需求并同步形成 ADR 与术语材料。",
      "inputs": ["需求草稿", "约束"],
      "outputs": ["压力测试结论", "决策材料"]
    },
    {
      "alias": "to-spec",
      "skill": "to-spec",
      "level": "L1",
      "description": "把已收敛对话整理为可执行规格。",
      "inputs": ["确认边界", "来源事实"],
      "outputs": ["规格", "验收标准"]
    },
    {
      "alias": "domain-modeling",
      "skill": "domain-modeling",
      "level": "L1",
      "description": "建立领域模型、统一语言和关键边界。",
      "inputs": ["已确认需求", "现有领域事实"],
      "outputs": ["领域模型", "统一语言"]
    },
    {
      "alias": "codebase-design",
      "skill": "codebase-design",
      "level": "L1",
      "description": "设计深模块、接口和代码职责边界。",
      "inputs": ["系统边界", "调用关系"],
      "outputs": ["模块设计", "接口选择"]
    },
    {
      "alias": "architecture-diagram",
      "skill": "architecture-diagram",
      "level": "L2",
      "description": "把已确认的系统关系表达为可审查架构图。",
      "inputs": ["架构事实", "系统边界"],
      "outputs": ["架构图"]
    },
    {
      "alias": "prototype",
      "skill": "prototype",
      "level": "L1",
      "description": "构建可丢弃的逻辑或 UI 原型以消除设计不确定性。",
      "inputs": ["设计问题", "验收边界"],
      "outputs": ["可运行原型", "学习结论"]
    },
    {
      "alias": "web-design",
      "skill": "web-design",
      "level": "L1",
      "description": "从需求与参考事实生成可执行网页设计。",
      "inputs": ["PRD", "原型", "视觉约束"],
      "outputs": ["设计规范", "可运行设计"]
