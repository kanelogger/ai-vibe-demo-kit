    {
      "alias": "improve-codebase-architecture",
      "skill": "improve-codebase-architecture",
      "level": "L2",
      "description": "基于稳定基线识别架构深化和性能改进机会。",
      "inputs": ["代码库", "基线"],
      "outputs": ["审查报告", "改进候选"]
    },
    {
      "alias": "research",
      "skill": "research",
