{
  "description": "Deliver registered directory context before structured file writes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness/adapters/pre-tool-use.mjs\"",
            "timeout": 30,
            "statusMessage": "Loading write context",
            "additionalContextLimit": 12000
          }
        ]
      }
    ]
  }
}
