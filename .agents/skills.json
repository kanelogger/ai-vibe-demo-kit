    {
      "alias": "grilling",
      "skill": "grilling",
      "level": "L1",
      "description": "对候选方案执行压力测试并暴露薄弱假设。",
      "inputs": ["候选方案", "约束"],
      "outputs": ["风险", "挑战问题"]
    },
    {
      "alias": "triage",
      "skill": "triage",
      "level": "L2",
      "description": "按状态、风险和阻塞关系整理待处理事项。",
      "inputs": ["问题集合", "验证结果"],
      "outputs": ["分类结果", "下一动作"]
    },
    {
      "alias": "wayfinder",
      "skill": "wayfinder",
      "level": "L2",
      "description": "为高风险或大型工作绘制共享决策和依赖地图。",
      "inputs": ["选定方案", "依赖事实"],
      "outputs": ["决策地图", "依赖顺序"]
    },
    {
      "alias": "to-tickets",
      "skill": "to-tickets",
      "level": "L1",
      "description": "把方案拆为声明依赖和验收条件的可执行切片。",
      "inputs": ["选定方案", "验收标准"],
      "outputs": ["Slice 计划", "依赖边"]
    },
    {
      "alias": "implement",
      "skill": "implement",
      "level": "L1",
      "description": "按规格和 Slice 边界实现可运行变更。",
      "inputs": ["Slice", "规格", "Write Scope"],
      "outputs": ["实现", "运行证据"]
    },
    {
      "alias": "tdd",
      "skill": "tdd",
      "level": "L1",
      "description": "为稳定行为、边界和不变量建立快速反馈。",
      "inputs": ["验收标准", "行为边界"],
      "outputs": ["自动化测试", "验证结果"]
    },
    {
      "alias": "code-review",
      "skill": "code-review",
      "level": "L1",
      "description": "按规格和工程标准审查固定变更基线。",
      "inputs": ["变更", "规格", "验证结果"],
      "outputs": ["审查发现", "合入风险"]
    },
    {
      "alias": "diagnosing-bugs",
      "skill": "diagnosing-bugs",
      "level": "L1",
      "description": "通过可重复反馈循环定位缺陷或失败根因。",
      "inputs": ["复现步骤", "错误输出", "既有承诺"],
      "outputs": ["根因", "修复边界"]
