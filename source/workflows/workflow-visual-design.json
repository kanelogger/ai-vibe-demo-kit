{
  "schemaVersion": 2,
  "id": "visual-design-skill-workflow",
  "version": 1,
  "description": "A visual design control workflow with baoyu design guidance and an optional architecture diagram.",
  "skillsCatalogRef": "source/workflows/skills-list.json",
  "initialStage": "alignment",
  "stages": {
    "alignment": {
      "goal": "Freeze intent, observable acceptance criteria, risk and the visual design shape.",
      "outcomes": [
        "ready",
        "blocked"
      ],
      "exitConditions": [
        {
          "id": "acceptance-observable",
          "description": "Every acceptance criterion names an observable result and evidence path.",
          "required": true
        },
        {
          "id": "risk-classified",
          "description": "Risk signals and rollback expectations have been recorded.",
          "required": true
        },
        {
          "id": "environment-confirmed",
          "description": "Required environment probes match project.yml or every deviation is reported with evidence.",
          "required": true
        }
      ],
      "skillCalls": [
        {
          "id": "alignment.harness-guide",
          "skill": "ai-vibe-demo-kit",
          "required": true,
          "artifactIds": ["spec"]
        },
        {
          "id": "alignment.baoyu-design",
          "skill": "baoyu-design",
          "required": true,
          "artifactIds": ["spec"]
        }
      ],
      "requiredArtifacts": [
        {
          "id": "spec",
          "required": true
        }
      ]
    },
    "implementation": {
      "goal": "Produce only the confirmed visual artifacts and preserve current verification evidence.",
      "outcomes": [
        "ready-for-acceptance",
        "blocked"
      ],
      "exitConditions": [
        {
          "id": "scope-complete",
          "description": "The confirmed scope is implemented without unapproved expansion.",
          "required": true
        },
        {
          "id": "quick-evidence-current",
          "description": "Focused verification evidence matches the current candidate.",
          "required": true
        }
      ],
      "skillCalls": [
        {
          "id": "implementation.harness-guide",
          "skill": "ai-vibe-demo-kit",
          "required": true,
          "artifactIds": ["implementation-notes", "quick-evidence"]
        },
        {
          "id": "implementation.baoyu-design",
          "skill": "baoyu-design",
          "required": true,
          "artifactIds": ["implementation-notes", "quick-evidence"]
        },
        {
          "id": "implementation.architecture-diagram",
          "skill": "architecture-diagram",
          "required": false,
          "artifactIds": ["quick-evidence"]
        }
      ],
      "requiredArtifacts": [
        {
          "id": "implementation-notes",
          "required": true
        },
        {
          "id": "quick-evidence",
          "required": true
        }
      ]
    },
    "acceptance": {
      "goal": "Prove specification compliance, aesthetic quality and cleanup before delivery.",
      "outcomes": [
        "accepted",
        "changes-requested",
        "blocked"
      ],
      "exitConditions": [
        {
          "id": "spec-compliant",
          "description": "The candidate satisfies the confirmed specification.",
          "required": true
        },
        {
          "id": "regression-safe",
          "description": "Required regression checks and critical paths passed.",
          "required": true
        },
        {
          "id": "cleanup-complete",
          "description": "Temporary data, files and processes created by verification were cleaned up.",
          "required": true
        }
      ],
      "skillCalls": [
        {
          "id": "acceptance.harness-guide",
          "skill": "ai-vibe-demo-kit",
          "required": true,
          "artifactIds": ["verification-report", "handoff"]
        },
        {
          "id": "acceptance.baoyu-design",
          "skill": "baoyu-design",
          "required": true,
          "artifactIds": ["verification-report"]
        }
      ],
      "requiredArtifacts": [
        {
          "id": "verification-report",
          "required": true,
          "contract": "verification-report/v1"
        },
        {
          "id": "handoff",
          "required": true
        }
      ]
    }
  },
  "transitions": [
    {
      "id": "alignment-ready",
      "from": "alignment",
      "on": "ready",
      "to": "implementation",
      "gate": {
        "mode": "human",
        "prompt": "Confirm intent, acceptance criteria and risk before implementation.",
        "onReject": "alignment"
      }
    },
    {
      "id": "alignment-blocked",
      "from": "alignment",
      "on": "blocked",
      "to": "blocked",
      "gate": {
        "mode": "auto"
      }
    },
    {
      "id": "implementation-ready",
      "from": "implementation",
      "on": "ready-for-acceptance",
      "to": "acceptance",
      "gate": {
        "mode": "auto"
      }
    },
    {
      "id": "implementation-blocked",
      "from": "implementation",
      "on": "blocked",
      "to": "blocked",
      "gate": {
        "mode": "auto"
      }
    },
    {
      "id": "acceptance-approved",
      "from": "acceptance",
      "on": "accepted",
      "to": "complete",
      "gate": {
        "mode": "human",
        "prompt": "Accept the verified candidate and recorded residual risks.",
        "onReject": "acceptance"
      }
    },
    {
      "id": "acceptance-changes",
      "from": "acceptance",
      "on": "changes-requested",
      "to": "implementation",
      "gate": {
        "mode": "auto"
      }
    },
    {
      "id": "acceptance-blocked",
      "from": "acceptance",
      "on": "blocked",
      "to": "blocked",
      "gate": {
        "mode": "auto"
      }
    }
  ]
}
