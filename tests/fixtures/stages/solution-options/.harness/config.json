{
  "version": 1,
  "project": {
    "name": "fixture-project",
    "summary": "A small fixture project used to verify the harness checker.",
    "hasUserInterface": false
  },
  "commands": {
    "quick": {
      "static": [
        "node --check src/index.js"
      ],
      "test": [
        "node --test tests/"
      ]
    },
    "full": {
      "static": [],
      "test": []
    },
    "contracts": [
      "node tests/contract/check-contracts.mjs"
    ]
  },
  "criticalUserPaths": [],
  "recovery": {
    "testDataCleanup": [
      "node scripts/cleanup-test-data.mjs"
    ],
    "rollback": [
      "git revert <commit>"
    ]
  }
}
