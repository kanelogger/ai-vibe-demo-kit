{
  "version": 1,
  "project": {
    "name": "fixture-project",
    "summary": "A small fixture project used to verify the harness checker.",
    "hasUserInterface": true
  },
  "commands": {
    "quick": {
      "static": [
        "node --check src/index.js"
      ],
      "test": [
        "node --test tests/"
      ]
    },
    "full": {
      "static": [],
      "test": []
    },
    "contracts": [
      "node tests/contract/check-contracts.mjs"
    ]
  },
  "criticalUserPaths": [],
  "verification": {
    "reportPath": ".harness/verification-report.json",
    "maxAgeHours": 1000000,
    "commandTimeoutMs": 30000,
    "workspaceFingerprint": "none"
  },
  "recovery": {
    "testDataCleanup": [
      {
        "mode": "command",
        "command": "node scripts/cleanup-test-data.mjs"
      }
    ],
    "rollback": [
      "git revert <commit>"
    ]
  },
  "notes": "Static fixtures use immutable generated files as the equivalent workspace audit mechanism."
}
